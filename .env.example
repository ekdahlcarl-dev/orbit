ORBIT_ENV=development
ORBIT_SERVICE_NAME=orbit
DATABASE_URL=postgres://orbit:orbit@localhost:5433/orbit
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_DIR=.orbit-storage
LOG_LEVEL=info

# Secrets belong only in the server environment, never NEXT_PUBLIC_*.
ORBIT_OPERATOR_USER=operator
ORBIT_OPERATOR_PASSWORD=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_ALLOWED_INSTALLATION_IDS=
GITHUB_WEBHOOK_SECRET=

# ORB-12 AI assistant. Keep the key server-only.
OPENAI_API_KEY=
ORBIT_OPENAI_MODEL=gpt-5-mini
